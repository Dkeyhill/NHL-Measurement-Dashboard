# Copy this file to .env and fill in real values. .env is gitignored.
# No secret material lives in this file at all -- just a path to a
# passphrase-protected private key stored outside the repo entirely.
# The passphrase itself is typed at runtime, never stored anywhere.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_ROLE=NHL_DEVELOPER
SNOWFLAKE_WAREHOUSE=NHL_ETL
SNOWFLAKE_PRIVATE_KEY_PATH=C:\Users\you\.snowflake\keys\dev_rsa_key.p8